{
  "name": "lens-gitlab",
  "version": "0.1.0",
  "description": "See the GitLab CI pipelines of your projects next to what each cluster runs of them: services, Flux image automation, Helm charts and GitOps syncs.",
  "keywords": [
    "lens-extension"
  ],
  "license": "MIT",
  "author": "Radoslav Panev",
  "homepage": "https://github.com/rpanev/lens-gitlab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpanev/lens-gitlab.git"
  },
  "bugs": "https://github.com/rpanev/lens-gitlab/issues",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-types-check && lens-package-build --entry-point ./src/index.ts",
    "clean": "rimraf dist/",
    "test": "vitest run"
  },
  "dependencies": {
    "@k8slens/ask-ai-contracts": "^1.3.0",
    "@k8slens/cli-contracts": "^1.0.3",
    "@k8slens/cluster-contracts": "^2.4.0",
    "@k8slens/details-panel-components": "^1.0.2",
    "@k8slens/details-panel-contracts": "^1.1.0",
    "@k8slens/drop-down-menu-items": "^1.1.3",
    "@k8slens/electron-contracts": "^1.1.0",
    "@k8slens/element-components": "^3.9.1",
    "@k8slens/feature-core": "^7.5.2",
    "@k8slens/icon": "^4.0.0",
    "@k8slens/injectable": "^26.2.1",
    "@k8slens/input-components": "^1.0.1",
    "@k8slens/kubernetes-contracts": "^2.0.2",
    "@k8slens/main-view-contracts": "^1.3.2",
    "@k8slens/modal-components": "^1.2.0",
    "@k8slens/modal-contracts": "^1.0.2",
    "@k8slens/navigation-contracts": "^1.0.0",
    "@k8slens/navigator-components": "^1.0.3",
    "@k8slens/navigator-contracts": "^2.2.0",
    "@k8slens/notifications-contracts": "^1.0.2",
    "@k8slens/persistable-contracts": "^1.0.2",
    "@k8slens/status-bar-contracts": "^1.0.2",
    "@k8slens/stylesheet-contracts": "^1.0.0",
    "@k8slens/subscribable": "^1.2.0",
    "@k8slens/tab-contracts": "^1.2.0",
    "@k8slens/table-components": "^1.0.2",
    "@k8slens/table-contracts": "^2.0.2",
    "@k8slens/use-inject": "^1.0.2",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.0.0",
    "@k8slens/typescript": "^8.0.0",
    "@types/react": "^19.2.0",
    "rimraf": "^4.4.1",
    "vitest": "^3.2.7"
  }
}
